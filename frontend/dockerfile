# syntax=docker/dockerfile:1

##### Base image partagée : Node + pnpm via corepack #####
FROM node:24-alpine3.20 AS base

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /opt/app

##### 1. Dépendances #####
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

##### 2. Build de l'application #####
FROM base AS builder

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /opt/app/node_modules ./node_modules
COPY . .

RUN pnpm build

##### 3. Image de production, minimale et non-root #####
FROM node:24-alpine3.20 AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /opt/app

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Assets statiques et fichiers publics
COPY --from=builder /opt/app/public ./public

# Build "standalone" : serveur Node autonome + dépendances minimales
COPY --from=builder --chown=nextjs:nodejs /opt/app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /opt/app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
